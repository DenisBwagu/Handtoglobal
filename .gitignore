# HandToGlobal .gitignore

# Environment and Configuration
.env
.env.local
.env.production
config.local.php
config.production.php

# Database
*.db
*.sqlite
*.sqlite3
database/
db_backup/
logs/

# Allow specific database schema files
!db.sql
!db_handtoglobal.sql

# Server and Deployment
/.htaccess
/web.config
/apache.conf
nginx.conf

# Temporary Files
*.tmp
*.temp
*.cache
*.log
error.log
access.log

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Node.js (if used for build tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Composer (PHP dependencies)
/vendor/
composer.lock

# Build and Distribution
/build/
/dist/
/compiled/

# User Uploads and Media
uploads/
media/
files/
images/user/
temp/

# Cache and Sessions
/cache/
/sessions/
/tmp/

# Testing
/tests/
/coverage/
phpunit.xml

# Documentation Build
/docs/build/
/_build/

# Backup Files
*.bak
*.backup
*~

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# XAMPP Specific
/xampp/
/phpmyadmin/
/adminer.php

# Project Specific
admin/_temp/
admin/_cache/
admin/_logs/
admin/_backup/

# Security Sensitive Files
*.key
*.pem
*.crt
*.p12
secrets/
private/

# Development Files
dev/
development/
staging/

# Logs and Monitoring
*.log
logs/
monitoring/

# Performance and Profiling
*.prof
*.xhprof
profiling/

# Local Configuration
local.php
local_config.php
dev_config.php

# Database Migrations (if using migration system)
/migrations/*.sql.backup

# User Generated Content
/user_content/
/generated/
