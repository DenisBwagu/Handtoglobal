# Local environment and secrets
.env
.env.*
!.env.example
config.local.php
config.production.php
config_BAD.php
local.php
local_config.php
dev_config.php

# Database dumps and backups
*.sql
!db.sql
!db_handtoglobal.sql
!database_required_tables.sql
*.sql.gz
*.sql.zip
*.dump
*.bak
*.backup
*.old
*.orig
db_backup/
database/
backups/

# Logs, caches, sessions, temporary output
*.log
*.log.*
logs/
cache/
sessions/
tmp/
tmp_sessions/
*.tmp
*.temp
*.cache

# Local diagnostic/test/debug scripts
test_*.php
debug_*.php
check_*.php
fix_*.php
repair_*.php
setup_test_*.php
syntax_checker*.php
auth_test.php
db_test.php

# Dependencies and build output
vendor/
node_modules/
composer.lock
build/
dist/
compiled/

# Editors and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Uploaded runtime files: keep folders, ignore new private/user uploads by default.
uploads/*
!uploads/.gitkeep
!uploads/settings/
!uploads/settings/.gitkeep
!uploads/tasks/
!uploads/tasks/.gitkeep

# Do not ignore committed public image assets.
!images/
!assets/images/

# Server config is required for Apache fallback and deployment reference.
!.htaccess

# Sensitive keys/certificates
*.key
*.pem
*.p12
secrets/
private/
